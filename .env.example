# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
# PostgreSQL connection string. Prisma reads this directly.
DATABASE_URL="postgresql://user:password@localhost:5432/launchnest"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# GitHub OAuth app (github.com/settings/developers) — callback URL:
# http://localhost:3000/api/auth/callback/github
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# --- Future phases (not read by any code yet, documented ahead of time) ---
# S3-compatible object storage for build artifacts (Phase 2+)
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""

# AI website generator provider (Phase 5) — kept server-side only, never
# exposed to the client.
AI_PROVIDER_API_KEY=""

# Secret used to encrypt EnvironmentVariable values and GitHub tokens at rest
# (Phase 3/4). Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""
