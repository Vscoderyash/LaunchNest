# Copy to .env and fill in real values. Never commit .env.

# --- Firebase client config (NOT secret — safe in the browser bundle) ---
# From Firebase Console -> Project Settings -> General -> Your apps -> Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# --- Firebase Admin SDK (server-only, a REAL secret) ---
# Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key. Paste the entire downloaded JSON file as ONE LINE here.
FIREBASE_SERVICE_ACCOUNT_KEY=""

# --- Subdomain routing (spec section 8) ---
# Locally, set to localhost:3000 and visit http://<slug>.localhost:3000 to
# test per-project subdomains without editing /etc/hosts. In production,
# set to your real domain once wildcard DNS (*.yourdomain) is configured.
BASE_DOMAIN="localhost:3000"

# --- Future phases (not read by any code yet, documented ahead of time) ---
# Object storage for build artifacts / binary assets (Phase 2+ follow-up —
# Firebase Storage is the natural fit given the rest of the stack)
FIREBASE_STORAGE_BUCKET_FOR_ASSETS=""

# AI website generator provider (Phase 5) — kept server-side only, never
# exposed to the client.
AI_PROVIDER_API_KEY=""

# Secret used to encrypt EnvironmentVariable values and GitHub PATs at rest
# (AES-256-GCM). Must decode to exactly 32 bytes. Generate with:
# openssl rand -base64 32
ENCRYPTION_KEY=""
