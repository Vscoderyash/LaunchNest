# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
# PostgreSQL connection string. Prisma reads this directly.
# If your provider gives you both a pooled and a direct connection string
# (e.g. Supabase's "Connect" dialog under ORM -> Prisma), DATABASE_URL should
# be the pooled/transaction-mode one and DIRECT_URL the direct one below —
# Prisma needs the direct connection to run migrations reliably through a
# connection pooler like PgBouncer/Supavisor.
DATABASE_URL="postgresql://user:password@localhost:5432/launchnest"
DIRECT_URL="postgresql://user:password@localhost:5432/launchnest"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# GitHub OAuth app (github.com/settings/developers) — callback URL:
# http://localhost:3000/api/auth/callback/github
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# --- Subdomain routing (spec section 8) ---
# Locally, set to localhost:3000 and visit http://<slug>.localhost:3000 to
# test per-project subdomains without editing /etc/hosts. In production,
# set to your real domain once wildcard DNS (*.yourdomain) is configured.
BASE_DOMAIN="localhost:3000"

# --- Future phases (not read by any code yet, documented ahead of time) ---
# S3-compatible object storage for build artifacts (Phase 2+)
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""

# AI website generator provider (Phase 5) — kept server-side only, never
# exposed to the client.
AI_PROVIDER_API_KEY=""

# Secret used to encrypt EnvironmentVariable values at rest (AES-256-GCM).
# Must decode to exactly 32 bytes. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""
